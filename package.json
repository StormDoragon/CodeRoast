{
  "name": "coderoast",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Get your code roasted: savage jokes, line-numbered receipts, real fixes and a Banana Score. Runs entirely in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:action": "esbuild action/src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=action/dist/index.cjs --legal-comments=none"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-python": "^6.1.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@mlc-ai/web-llm": "^0.2.81",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^0.8.6",
    "codemirror": "^6.0.1",
    "idb": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
